  "regex": [
    { "pattern": "^(\\d+)\\s+agents?\\s+running$", "flags": "i", "replace": "$1 個代理執行中" },
    { "pattern": "^Running\\s+(\\d+)\\s+tools?$", "flags": "i", "replace": "正在執行 $1 個工具" },
    { "pattern": "^(\\d+)\\s+files?\\s+changed$", "flags": "i", "replace": "已變更 $1 個檔案" },
    { "pattern": "^(\\d+)\\s+items?$", "flags": "i", "replace": "$1 項" },
    { "pattern": "^(\\d+)\\s+selected$", "flags": "i", "replace": "已選取 $1 項" },
    { "pattern": "^([0-9.,]+)\\s*tokens?\\s+used$", "flags": "i", "replace": "已用 $1 tokens" },
    { "pattern": "^([0-9.,]+)%\\s+remaining$", "flags": "i", "replace": "剩餘 $1%" },
    { "pattern": "^Resets\\s+in\\s+(.+)$", "flags": "i", "replace": "距離重設剩餘 $1" },
    { "pattern": "^Updated\\s+(.+)\\s+ago$", "flags": "i", "replace": "$1前更新" },
    { "pattern": "^(\\d+)\\s+seconds?\\s+ago$", "flags": "i", "replace": "$1 秒前" },
    { "pattern": "^(\\d+)\\s+minutes?\\s+ago$", "flags": "i", "replace": "$1 分鐘前" },
    { "pattern": "^(\\d+)\\s+hours?\\s+ago$", "flags": "i", "replace": "$1 小時前" },
    { "pattern": "^(\\d+)\\s+days?\\s+ago$", "flags": "i", "replace": "$1 天前" },
    { "pattern": "^Just now$", "flags": "i", "replace": "剛剛" },
    { "pattern": "^Thought\\s+for\\s+(.+)$", "flags": "i", "replace": "已思考 $1" },
    { "pattern": "^Open\\s+(.+)$", "flags": "", "replace": "開啟 $1" },
    { "pattern": "^Close\\s+(.+)$", "flags": "", "replace": "關閉 $1" },
    { "pattern": "^Connect\\s+to\\s+(.+)$", "flags": "", "replace": "連線至 $1" },
    { "pattern": "^Quit\\s+Antigravity\\??$", "flags": "i", "replace": "確定要結束 Antigravity 嗎？" }
  ]
}
